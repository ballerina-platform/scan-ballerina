{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Ballerina Scan Tool",
          "semanticVersion": "0.12.0",
          "rules": [
            {"id": "ballerina:2", "shortDescription": {"text": "Rule two"}, "defaultConfiguration": {"level": "warning"}},
            {"id": "ballerina:1", "shortDescription": {"text": "Rule one"}, "defaultConfiguration": {"level": "note"}}
          ]
        }
      },
      "results": [
        {
          "rule": {"id": "ballerina:1", "index": 1}, "message": {"text": "Rule one"},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.bal"}, "region": {"startLine": 4}}}]
        },
        {
          "rule": {"index": 0}, "message": {"text": "Rule two"},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.bal"}, "region": {"startLine": 5}}}]
        },
        {
          "ruleIndex": 1, "message": {"text": "Rule one"},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.bal"}, "region": {"startLine": 6}}}]
        },
        {
          "level": "error", "message": {"text": "No rule"},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.bal"}, "region": {"startLine": 7}}}]
        }
      ]
    }
  ]
}
