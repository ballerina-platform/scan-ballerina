{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Ballerina Scan Tool",
          "semanticVersion": "0.12.0",
          "rules": [
            {"id": "ballerina:1", "shortDescription": {"text": "Rule one"}, "defaultConfiguration": {"level": "note"}}
          ]
        }
      },
      "artifacts": [
        {"location": {"uri": "main.bal"}},
        {"location": {"uri": "tests/main_test.bal"}}
      ],
      "results": [
        {
          "ruleId": "ballerina:1", "ruleIndex": 0, "level": "note", "message": {"text": "Rule one"},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.bal", "index": 0}, "region": {"startLine": 3}}}]
        }
      ]
    }
  ]
}
