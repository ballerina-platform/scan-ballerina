{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Ballerina Scan Tool",
          "semanticVersion": "0.13.0",
          "rules": [
            {"id": "ballerina:1", "shortDescription": {"text": "Rule one"}, "defaultConfiguration": {"level": "note"}, "properties": {"ruleKind": "CODE_SMELL"}}
          ]
        }
      },
      "results": [
        {
          "ruleId": "ballerina:1", "level": "note", "message": {"text": "Rule one"},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "lib.bal"}, "region": {"startLine": 2, "startColumn": 1}}}]
        }
      ]
    }
  ]
}
