{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Ballerina Scan Tool",
          "semanticVersion": "0.13.0",
          "rules": [
            {"id": "ballerina/crypto:2", "shortDescription": {"text": "Weak hash"}, "defaultConfiguration": {"level": "error"}, "properties": {"ruleKind": "VULNERABILITY"}},
            {"id": "ballerina:1", "shortDescription": {"text": "Rule one"}, "defaultConfiguration": {"level": "note"}, "properties": {"ruleKind": "CODE_SMELL"}}
          ]
        }
      },
      "results": [
        {
          "ruleId": "ballerina/crypto:2", "level": "error", "message": {"text": "Weak hash"},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.bal"}, "region": {"startLine": 4, "startColumn": 5}}}],
          "suppressions": [{"kind": "inSource", "status": "accepted", "justification": "Legacy hash kept for the migration window, SEC-1042"}]
        },
        {
          "ruleId": "ballerina:1", "level": "note", "message": {"text": "Rule one"},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.bal"}, "region": {"startLine": 8, "startColumn": 1}}}],
          "suppressions": [{"kind": "inSource"}]
        },
        {
          "ruleId": "ballerina:1", "level": "note", "message": {"text": "Rule one"},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.bal"}, "region": {"startLine": 12, "startColumn": 1}}}],
          "suppressions": [{"kind": "inSource", "status": "underReview"}]
        },
        {
          "ruleId": "ballerina/crypto:2", "level": "error", "message": {"text": "Weak hash"},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "main.bal"}, "region": {"startLine": 20, "startColumn": 5}}}],
          "suppressions": []
        }
      ]
    }
  ]
}
